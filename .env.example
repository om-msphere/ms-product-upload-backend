# --- Storage credentials (required) ---
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# --- Storage endpoints (required) ---
# How the API reaches storage (service name inside docker compose)
S3_INTERNAL_ENDPOINT=http://rustfs:9000
# Public URL clients use to open images; signed links are generated for this host
S3_PUBLIC_ENDPOINT=https://images.example.com

# --- Optional ---
S3_BUCKET=product-images
S3_REGION=us-east-1
# UPLOAD_PREFIX=uploads
# VIEW_URL_EXPIRES=3600
# MAX_UPLOAD_BYTES=10485760
# CREATE_BUCKET=true
# JSON list of allowed browser origins
# CORS_ORIGINS=["https://admin.example.com"]
