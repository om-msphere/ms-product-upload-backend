# --- Storage credentials (required) ---
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# --- Storage URL (required) ---
# RustFS / S3 address. Used by the API and in image links, so clients must be able to reach it.
S3_PUBLIC_ENDPOINT=https://storage.example.com

# --- Optional ---
S3_BUCKET=product-images
S3_REGION=us-east-1
# UPLOAD_PREFIX=uploads
# VIEW_URL_EXPIRES=3600
# MAX_UPLOAD_BYTES=10485760
# CREATE_BUCKET=true
# JSON list of allowed browser origins
# CORS_ORIGINS=["https://admin.example.com"]
